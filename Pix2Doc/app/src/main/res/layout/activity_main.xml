<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/main"
        app:subtitle="@string/tagline"
        app:title="@string/app_name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_photos"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="start|center_vertical"
            android:text="@string/pick_photos"
            android:textSize="17sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_image"
            app:iconPadding="16dp"
            app:iconSize="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_files"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="@string/pick_files"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_folder"
            app:iconPadding="16dp"
            app:iconSize="26dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_pdf"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="@string/open_pdf"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_pdf"
            app:iconPadding="16dp"
            app:iconSize="26dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:text="@string/recent_files"
        android:textAppearance="?attr/textAppearanceTitleSmall" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_recents"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:drawablePadding="10dp"
        android:padding="16dp"
        android:text="@string/share_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        app:drawableStartCompat="@drawable/ic_share" />
</LinearLayout>
